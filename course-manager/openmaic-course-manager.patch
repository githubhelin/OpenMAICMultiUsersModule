@@ -0,0 +1,880 @@
+'use client';
+
+import React, { useEffect, useState, useMemo, useTransition } from 'react';
+import { useRouter } from 'next/navigation';
+import {
+  BookOpen,
+  Sparkles,
+  Play,
+  Edit3,
+  Trash2,
+  Copy,
+  Check,
+  Search,
+  ArrowLeft,
+  Calendar,
+  Layers,
+  RefreshCw,
+  ExternalLink,
+  Plus,
+  AlertCircle,
+  Clock,
+  CheckCircle2,
+  Laptop,
+  FolderOpen,
+  Cloud,
+  CloudUpload,
+  HardDrive,
+  Database,
+} from 'lucide-react';
+import { useAuthStore } from '@/lib/store/auth-store';
+import { UserNav } from '@/components/auth/user-nav';
+import { AuthDialog } from '@/components/auth/auth-dialog';
+import {
+  listStages,
+  deleteStageData,
+  renameStage,
+  loadStageData,
+} from '@/lib/utils/stage-storage';
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Badge } from '@/components/ui/badge';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog';
+import { toast } from 'sonner';
+
+interface CourseItem {
+  id: string;
+  name: string;
+  description?: string;
+  sceneCount?: number;
+  createdAt: number;
+  updatedAt: number;
+  interactiveMode?: boolean;
+  taskEngineMode?: boolean;
+  folderId?: string;
+  isCloudSynced?: boolean;
+}
+
+type SortField = 'updatedAt' | 'createdAt' | 'name' | 'sceneCount';
+type FilterType = 'all' | 'interactive' | 'cloud' | 'local';
+
+export default function MyCoursesPage() {
+  const router = useRouter();
+  const { user, authModalOpen, setAuthModalOpen } = useAuthStore();
+
+  const [courses, setCourses] = useState<CourseItem[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [isPending, startTransition] = useTransition();
+
+  // Search & Filter
+  const [searchQuery, setSearchQuery] = useState('');
+  const [sortField, setSortField] = useState<SortField>('updatedAt');
+  const [sortAsc, setSortAsc] = useState(false);
+  const [filterType, setFilterType] = useState<FilterType>('all');
+
+  // Rename state
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameDraft, setRenameDraft] = useState('');
+  const [renamingSubmitting, setRenamingSubmitting] = useState(false);
+
+  // Delete state
+  const [deletingCourse, setDeletingCourse] = useState<CourseItem | null>(null);
+  const [deleteSubmitting, setDeleteSubmitting] = useState(false);
+
+  // Cloud sync state
+  const [syncingId, setSyncingId] = useState<string | null>(null);
+  const [batchSyncing, setBatchSyncing] = useState(false);
+
+  // Copy feedback
+  const [copiedId, setCopiedId] = useState<string | null>(null);
+
+  // Fetch courses from both IndexedDB (historical) and PostgreSQL (cloud)
+  const fetchCourses = async () => {
+    setLoading(true);
+    try {
+      // 1. 获取本地 IndexedDB 存储的所有历史课程
+      let localStages: CourseItem[] = [];
+      try {
+        const local = await listStages();
+        localStages = local.map((s) => ({
+          ...s,
+          isCloudSynced: false,
+        }));
+      } catch (err) {
+        console.warn('Failed to load local stages:', err);
+      }
+
+      // 2. 获取服务端 PostgreSQL 云端数据库存储的所有课程（包含批量制课等）
+      let serverStages: CourseItem[] = [];
+      try {
+        const res = await fetch('/api/stages', {
+          credentials: 'include',
+        });
+        if (res.ok) {
+          const data = await res.json();
+          if (data && Array.isArray(data.stages)) {
+            serverStages = data.stages.map((s: any) => ({
+              ...s,
+              isCloudSynced: true,
+            }));
+          }
+        }
+      } catch (err) {
+        console.warn('Failed to load server stages:', err);
+      }
+
+      // 3. 智能双向聚合去重合并（确保全部历史本地课程与云端课程 100% 汇总）
+      const map = new Map<string, CourseItem>();
+
+      // 先存入云端课程
+      for (const s of serverStages) {
+        map.set(s.id, { ...s, isCloudSynced: true });
+      }
+
+      // 补入本地历史课件
+      for (const l of localStages) {
+        if (!map.has(l.id)) {
+          map.set(l.id, { ...l, isCloudSynced: false });
+        } else {
+          const existing = map.get(l.id)!;
+          map.set(l.id, {
+            ...existing,
+            isCloudSynced: true,
+            sceneCount: existing.sceneCount || l.sceneCount,
+            interactiveMode: existing.interactiveMode ?? l.interactiveMode,
+            taskEngineMode: existing.taskEngineMode ?? l.taskEngineMode,
+            updatedAt: Math.max(existing.updatedAt || 0, l.updatedAt || 0),
+          });
+        }
+      }
+
+      const merged = Array.from(map.values());
+      setCourses(merged);
+    } catch (err) {
+      console.error('Failed to fetch courses:', err);
+      toast.error('网络异常，获取课程失败');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    fetchCourses();
+  }, []);
+
+  // Filtered and Sorted Courses
+  const filteredCourses = useMemo(() => {
+    return courses
+      .filter((course) => {
+        if (filterType === 'interactive' && !course.interactiveMode) return false;
+        if (filterType === 'cloud' && !course.isCloudSynced) return false;
+        if (filterType === 'local' && course.isCloudSynced) return false;
+
+        if (searchQuery.trim()) {
+          const q = searchQuery.toLowerCase().trim();
+          const matchName = course.name.toLowerCase().includes(q);
+          const matchDesc = course.description?.toLowerCase().includes(q);
+          const matchId = course.id.toLowerCase().includes(q);
+          return matchName || matchDesc || matchId;
+        }
+        return true;
+      })
+      .sort((a, b) => {
+        let valA: any = a[sortField] ?? 0;
+        let valB: any = b[sortField] ?? 0;
+        if (sortField === 'name') {
+          return sortAsc ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name);
+        }
+        return sortAsc ? valA - valB : valB - valA;
+      });
+  }, [courses, searchQuery, sortField, sortAsc, filterType]);
+
+  // Total stats
+  const totalSlides = useMemo(() => {
+    return courses.reduce((sum, c) => sum + (c.sceneCount || 0), 0);
+  }, [courses]);
+
+  const interactiveCoursesCount = useMemo(() => {
+    return courses.filter((c) => c.interactiveMode).length;
+  }, [courses]);
+
+  const unsyncedCount = useMemo(() => {
+    return courses.filter((c) => !c.isCloudSynced).length;
+  }, [courses]);
+
+  // Sync single local course to cloud
+  const syncToCloud = async (course: CourseItem) => {
+    setSyncingId(course.id);
+    try {
+      const doc = await loadStageData(course.id);
+      if (!doc || !doc.stage) {
+        toast.error('未找到该课件的本地详细场景数据');
+        return;
+      }
+      const res = await fetch('/api/classroom', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'include',
+        body: JSON.stringify({
+          stage: doc.stage,
+          scenes: doc.scenes || [],
+        }),
+      });
+      if (res.ok) {
+        setCourses((prev) =>
+          prev.map((c) => (c.id === course.id ? { ...c, isCloudSynced: true } : c)),
+        );
+        toast.success(`课程 "${course.name}" 已成功备份至云端数据库`);
+      } else {
+        toast.error('云端备份失败，请检查网络');
+      }
+    } catch (err) {
+      console.error('Failed to sync course:', err);
+      toast.error('同步异常，请稍后重试');
+    } finally {
+      setSyncingId(null);
+    }
+  };
+
+  // Sync all local courses to cloud in batch
+  const syncAllLocalToCloud = async () => {
+    const unsynced = courses.filter((c) => !c.isCloudSynced);
+    if (unsynced.length === 0) {
+      toast.info('所有课件已全部存储于云端数据库中');
+      return;
+    }
+    setBatchSyncing(true);
+    toast.info(`开始后台同步 ${unsynced.length} 门历史课件到云端数据库...`);
+    let successCount = 0;
+    for (const c of unsynced) {
+      try {
+        const doc = await loadStageData(c.id);
+        if (doc && doc.stage) {
+          const res = await fetch('/api/classroom', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            credentials: 'include',
+            body: JSON.stringify({
+              stage: doc.stage,
+              scenes: doc.scenes || [],
+            }),
+          });
+          if (res.ok) {
+            successCount++;
+            setCourses((prev) =>
+              prev.map((item) => (item.id === c.id ? { ...item, isCloudSynced: true } : item)),
+            );
+          }
+        }
+      } catch (e) {
+        console.warn(`Failed to sync ${c.id}:`, e);
+      }
+    }
+    setBatchSyncing(false);
+    toast.success(`已成功将 ${successCount} 门历史课件同步至云端数据库！`);
+  };
+
+  // Rename Course (Dual Save: Local & Server)
+  const startRename = (course: CourseItem) => {
+    setRenamingId(course.id);
+    setRenameDraft(course.name);
+  };
+
+  const submitRename = async () => {
+    if (!renamingId || !renameDraft.trim()) return;
+    const newName = renameDraft.trim();
+    setRenamingSubmitting(true);
+    try {
+      // 1. 本地更新
+      try {
+        await renameStage(renamingId, newName);
+      } catch {}
+
+      // 2. 云端更新
+      try {
+        await fetch(`/api/stages/${encodeURIComponent(renamingId)}`, {
+          method: 'PATCH',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'include',
+          body: JSON.stringify({ name: newName }),
+        });
+      } catch {}
+
+      setCourses((prev) =>
+        prev.map((c) => (c.id === renamingId ? { ...c, name: newName, updatedAt: Date.now() } : c)),
+      );
+      toast.success('课程重命名成功');
+      setRenamingId(null);
+    } catch {
+      toast.error('重命名请求异常');
+    } finally {
+      setRenamingSubmitting(false);
+    }
+  };
+
+  // Delete Course (Dual Delete: Local & Server)
+  const confirmDelete = async () => {
+    if (!deletingCourse) return;
+    setDeleteSubmitting(true);
+    try {
+      // 1. 本地 IndexedDB 彻底删除
+      try {
+        await deleteStageData(deletingCourse.id);
+      } catch (e) {
+        console.warn('Failed to delete from local storage:', e);
+      }
+
+      // 2. 服务端 PostgreSQL 彻底删除
+      try {
+        await fetch(`/api/stages/${encodeURIComponent(deletingCourse.id)}`, {
+          method: 'DELETE',
+          credentials: 'include',
+        });
+      } catch (e) {
+        console.warn('Failed to delete from server:', e);
+      }
+
+      setCourses((prev) => prev.filter((c) => c.id !== deletingCourse.id));
+      toast.success(`课程 "${deletingCourse.name}" 已成功删除`);
+      setDeletingCourse(null);
+    } catch {
+      toast.error('删除请求异常');
+    } finally {
+      setDeleteSubmitting(false);
+    }
+  };
+
+  // Copy share URL
+  const copyShareLink = (id: string) => {
+    const url = `${window.location.origin}/classroom/${encodeURIComponent(id)}`;
+    navigator.clipboard.writeText(url);
+    setCopiedId(id);
+    toast.success('课堂专属链接已复制到剪贴板');
+    setTimeout(() => setCopiedId(null), 2000);
+  };
+
+  const formatDate = (ts: number | string | undefined) => {
+    if (!ts) return '未知时间';
+    const d = new Date(typeof ts === 'number' ? ts : Number(ts));
+    if (isNaN(d.getTime())) return '未知时间';
+    return d.toLocaleString('zh-CN', {
+      year: 'numeric',
+      month: '2-digit',
+      day: '2-digit',
+      hour: '2-digit',
+      minute: '2-digit',
+    });
+  };
+
+  return (
+    <div className="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col">
+      {/* 顶部导航 */}
+      <header className="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-40">
+        <div className="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
+          <div className="flex items-center gap-3">
+            <Button
+              variant="ghost"
+              size="sm"
+              onClick={() => router.push('/')}
+              className="gap-1.5 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
+            >
+              <ArrowLeft className="w-4 h-4" />
+              返回首页
+            </Button>
+            <div className="h-4 w-px bg-slate-200 dark:bg-slate-800" />
+            <div className="flex items-center gap-2.5">
+              <div className="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white shadow-sm shadow-indigo-500/20">
+                <BookOpen className="w-4 h-4" />
+              </div>
+              <div>
+                <h1 className="font-semibold text-base leading-tight">我的课程中心</h1>
+                <p className="text-xs text-slate-500 dark:text-slate-400">
+                  全量汇总管理本地历史与云端生成的所有课件
+                </p>
+              </div>
+            </div>
+          </div>
+
+          <div className="flex items-center gap-2.5">
+            {unsyncedCount > 0 && (
+              <Button
+                variant="outline"
+                size="sm"
+                onClick={syncAllLocalToCloud}
+                disabled={batchSyncing}
+                className="gap-1.5 text-emerald-600 dark:text-emerald-400 border-emerald-500/30 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-xs"
+                title="将浏览器本地历史缓存的所有课程一键备份同步到 PostgreSQL 云端数据库"
+              >
+                <CloudUpload className={`w-3.5 h-3.5 ${batchSyncing ? 'animate-bounce' : ''}`} />
+                {batchSyncing ? '正在备份上云...' : `一键上云备份 (${unsyncedCount})`}
+              </Button>
+            )}
+
+            <Button
+              variant="outline"
+              size="sm"
+              onClick={() => router.push('/batch-studio')}
+              className="gap-1.5 text-amber-600 dark:text-amber-400 border-amber-500/30 hover:bg-amber-50 dark:hover:bg-amber-950/40 text-xs"
+            >
+              <Sparkles className="w-3.5 h-3.5" />
+              批量快速制课
+            </Button>
+
+            <Button
+              variant="default"
+              size="sm"
+              onClick={() => router.push('/')}
+              className="gap-1.5 shadow-sm text-xs"
+            >
+              <Plus className="w-3.5 h-3.5" />
+              制作新课程
+            </Button>
+
+            <Button
+              variant="ghost"
+              size="icon"
+              onClick={fetchCourses}
+              disabled={loading}
+              title="刷新列表"
+              className="w-8 h-8 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white"
+            >
+              <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} />
+            </Button>
+
+            <div className="h-4 w-px bg-slate-200 dark:bg-slate-800" />
+            <UserNav />
+          </div>
+        </div>
+      </header>
