+  Minimize2,
+  X,
+  Play,
+  Layers,
+  LayoutGrid,
+  ChevronRight,
+  ArrowLeft,
+  Loader2,
+  FolderOpen,
+  RefreshCw,
+  CheckCircle2,
+} from 'lucide-react';
