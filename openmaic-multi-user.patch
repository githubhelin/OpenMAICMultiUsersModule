+++          }
+++        }
+++      });
+++    }
+++
+++    // 启动下一个任务的执行流水线
+++    const jobPromise = executeBatchJobInternal(nextJob.id, nextJob.baseUrl || effectiveBaseUrl);
+++    runningBatchJobs.set(nextJob.id, jobPromise);
+++  } catch (err) {
+++    log.error('Failed in scheduleNextBatchJob:', err);
+++  } finally {
+++    isScheduling = false;
+++  }
+++}
