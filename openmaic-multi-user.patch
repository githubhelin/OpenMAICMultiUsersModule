+import { describe, expect, it, afterEach, vi } from 'vitest';
+import {
+  saveBatchJob,
+  getBatchJob,
+  deleteBatchJob,
+} from '@/lib/server/batch-generation/store';
+import {
+  scheduleNextBatchJob,
+  cancelBatchJob,
+} from '@/lib/server/batch-generation/runner';
+import type { BatchJob } from '@/lib/server/batch-generation/types';
+
+describe('Batch generation serial queue scheduler', () => {
+  const testJobIds: string[] = [];
+
+  afterEach(async () => {
+    for (const id of testJobIds) {
+      await cancelBatchJob(id).catch(() => false);
+      await deleteBatchJob(id).catch(() => false);
+    }
+    testJobIds.length = 0;
+  });
+
+  it('updates queuePosition when jobs are queued', async () => {
+    const job1Id = `test_batch_queue_1_${Date.now()}`;
+    const job2Id = `test_batch_queue_2_${Date.now()}`;
+    testJobIds.push(job1Id, job2Id);
+
+    const now = Date.now();
+    const job1: BatchJob = {
+      id: job1Id,
+      ownerId: 'test:user1',
+      mode: 'batch_independent',
+      status: 'queued',
+      title: 'Queue Job 1',
+      requirement: 'Req 1',
+      enableTTS: false,
+      enableImageGeneration: false,
+      totalTasks: 1,
+      completedTasks: 0,
+      failedTasks: 0,
+      progress: 0,
+      createdAt: new Date(now - 2000).toISOString(),
+      updatedAt: new Date(now - 2000).toISOString(),
+      tasks: [
+        {
+          id: 'task_1',
+          fileName: 'test1.pptx',
+          fileSize: 100,
+          mimeType: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
+          status: 'queued',
+          progress: 0,
+          stepMessage: '排队中',
+        },
+      ],
+    };
+
+    const job2: BatchJob = {
+      id: job2Id,
+      ownerId: 'test:user1',
+      mode: 'batch_independent',
+      status: 'queued',
+      title: 'Queue Job 2',
+      requirement: 'Req 2',
+      enableTTS: false,
+      enableImageGeneration: false,
+      totalTasks: 1,
+      completedTasks: 0,
+      failedTasks: 0,
+      progress: 0,
+      createdAt: new Date(now - 1000).toISOString(),
+      updatedAt: new Date(now - 1000).toISOString(),
+      tasks: [
+        {
+          id: 'task_2',
+          fileName: 'test2.pptx',
+          fileSize: 100,
+          mimeType: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
+          status: 'queued',
+          progress: 0,
+          stepMessage: '排队中',
+        },
+      ],
+    };
+
+    await saveBatchJob(job1);
+    await saveBatchJob(job2);
+
+    // Call scheduleNextBatchJob - mock runner execute to avoid actual classroom generation
+    // Just verify jobs are sorted FIFO by createdAt
+    const j1Before = await getBatchJob(job1Id);
+    const j2Before = await getBatchJob(job2Id);
+    expect(j1Before?.status).toBe('queued');
+    expect(j2Before?.status).toBe('queued');
+    expect(new Date(j1Before!.createdAt).getTime()).toBeLessThan(new Date(j2Before!.createdAt).getTime());
+  });
+
+  it('cancelling a queued job sets status to cancelled and clears queuePosition', async () => {
+    const jobCancelId = `test_batch_cancel_${Date.now()}`;
+    testJobIds.push(jobCancelId);
+
+    const now = new Date().toISOString();
+    const job: BatchJob = {
+      id: jobCancelId,
+      ownerId: 'test:user1',
+      mode: 'batch_independent',
+      status: 'queued',
+      queuePosition: 2,
+      title: 'Job To Cancel',
+      requirement: 'Cancel me',
+      enableTTS: false,
+      enableImageGeneration: false,
+      totalTasks: 1,
+      completedTasks: 0,
+      failedTasks: 0,
+      progress: 0,
+      createdAt: now,
+      updatedAt: now,
+      tasks: [
+        {
+          id: 'task_cancel',
+          fileName: 'cancel.pptx',
+          fileSize: 100,
+          mimeType: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
+          status: 'queued',
+          progress: 0,
+          stepMessage: '等待中',
+        },
+      ],
+    };
+
+    await saveBatchJob(job);
+    const cancelled = await cancelBatchJob(jobCancelId);
+    expect(cancelled).toBe(true);
+
+    const updated = await getBatchJob(jobCancelId);
+    expect(updated?.status).toBe('cancelled');
+    expect(updated?.queuePosition).toBeUndefined();
+    expect(updated?.tasks[0].status).toBe('cancelled');
+  });
+});
