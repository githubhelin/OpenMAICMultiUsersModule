++    }
++
++    const { id } = await params;
++    if (id === currentUser.id) {
++      return NextResponse.json({ success: false, error: 'Cannot delete your own admin account' }, { status: 400 });
++    }
++
++    const deleted = await deleteUser(id);
++    if (!deleted) {
