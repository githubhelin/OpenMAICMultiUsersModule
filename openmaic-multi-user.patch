+            <Button
+              variant="destructive"
+              size="sm"
+              onClick={confirmDelete}
+              disabled={deleteSubmitting}
+              className="rounded-xl text-xs bg-red-600 hover:bg-red-700 text-white font-medium"
+            >
+              {deleteSubmitting ? '正在删除...' : '确认彻底删除'}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
