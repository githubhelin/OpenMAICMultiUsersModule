++## 🗄️ 数据表结构 (PostgreSQL)
++
++```sql
++CREATE TABLE IF NOT EXISTS users (
++  id TEXT PRIMARY KEY,               -- 格式: usr_<nanoid>
++  username TEXT UNIQUE NOT NULL,     -- 登录用户名 (小写规范)
++  email TEXT UNIQUE,                 -- 电子邮箱
++  password_hash TEXT NOT NULL,       -- scrypt 派生哈希
++  salt TEXT NOT NULL,                -- 16字节安全随机盐
++  nickname TEXT NOT NULL,            -- 显示昵称
++  avatar TEXT NOT NULL DEFAULT '/avatars/user.png',
++  bio TEXT,                          -- 个人简介
++  role TEXT NOT NULL DEFAULT 'user', -- 'admin' | 'user'
++  is_active BOOLEAN NOT NULL DEFAULT TRUE, -- 是否启用
++  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
++  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
++);
++
++CREATE INDEX IF NOT EXISTS idx_users_username ON users(username);
++CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);
++```
