++        log.info(`Removed empty interactive directory for stage ${stageId}`);
++      } catch (err) {
++        log.warn(`Failed to remove empty directory ${existingDir}:`, err);
++      }
++    }
++    return null;
++  }
++
++  await ensureBaseDir();
++
