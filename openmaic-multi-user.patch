+                </div>
+                <div className="flex flex-wrap gap-2">
+                  {recentJobs.map((j) => (
+                    <div key={j.id} className="flex items-center gap-1">
+                      <Button
+                        size="sm"
+                        variant={activeJobId === j.id ? 'secondary' : 'outline'}
