+/**
+ * Hybrid User-bound KVStore that seamlessly syncs `account` scope configurations
+ * (API Keys, MinerU URL, Model Routes, TTS Voices, User Profile) with the PostgreSQL
+ * database via `/api/kv/entries/*` while keeping `device` scope (theme, layout) local.
+ *
+ * Guarantees:
+ * 1. Instant local response (writes to local cache immediately).
+ * 2. Cross-device roaming (hydrates from server on login).
+ * 3. Automatic first-time migration (uploads existing local settings to server if empty).
+ * 4. Resilient fallback (graceful offline / guest degradation).
+ */
+export class UserSyncedKVStore implements DeviceSafeKVStore {
+  readonly isLocalKVStore = false as const;
+  readonly servesDeviceScopeLocally = true as const;
+  private readonly local: BrowserKVStore;
+
+  constructor(local?: BrowserKVStore) {
+    this.local = local ?? new BrowserKVStore();
+  }
+
+  async get<T>(key: string, scope: KVScope = DEFAULT_KV_SCOPE): Promise<T | null> {
+    if (scope === 'device') {
+      return this.local.get<T>(key, 'device');
+    }
+
+    // scope === 'account'
+    if (typeof window !== 'undefined') {
+      try {
+        const res = await fetch(`/api/kv/entries/${encodeURIComponent(key)}`, {
+          method: 'GET',
+          credentials: 'include',
+          cache: 'no-store',
+        });
+
+        if (res.ok) {
+          const data = await res.json();
+          if (data && 'value' in data) {
+            if (data.value !== null) {
+              // Authoritative server record found -> update local cache
+              try {
+                await this.local.set(key, data.value, 'account');
+              } catch {
+                // Ignore local cache error
+              }
+              return data.value as T;
+            } else {
+              // Server has no record yet for this account (e.g. freshly created user).
+              // Check if this computer has existing local settings to automatically migrate!
+              const localVal = await this.local.get<T>(key, 'account');
+              if (localVal !== null && localVal !== undefined) {
+                log.info(`Auto-migrating local settings for [${key}] to server user account...`);
+                void fetch(`/api/kv/entries/${encodeURIComponent(key)}`, {
+                  method: 'PUT',
+                  headers: { 'Content-Type': 'application/json' },
+                  credentials: 'include',
+                  body: JSON.stringify({ value: localVal }),
+                }).catch(() => {});
+                return localVal;
+              }
+              return null;
+            }
+          }
+        }
+      } catch (err) {
+        log.warn(`Failed to fetch server KV for [${key}], falling back to local:`, err);
+      }
+    }
+
+    return this.local.get<T>(key, 'account');
+  }
+
+  async set<T>(key: string, value: T, scope: KVScope = DEFAULT_KV_SCOPE): Promise<void> {
+    if (scope === 'device') {
+      return this.local.set<T>(key, value, 'device');
+    }
+
+    // Always update local cache first for instant feedback
+    await this.local.set<T>(key, value, 'account');
+
+    // Sync to PostgreSQL in background
+    if (typeof window !== 'undefined') {
+      try {
+        await fetch(`/api/kv/entries/${encodeURIComponent(key)}`, {
+          method: 'PUT',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'include',
+          body: JSON.stringify({ value }),
+        });
+      } catch (err) {
+        log.warn(`Failed to sync KV [${key}] to server:`, err);
+      }
+    }
+  }
+
+  async remove(key: string, scope: KVScope = DEFAULT_KV_SCOPE): Promise<void> {
+    if (scope === 'device') {
+      return this.local.remove(key, 'device');
+    }
+
+    await this.local.remove(key, 'account');
+
+    if (typeof window !== 'undefined') {
+      try {
+        await fetch(`/api/kv/entries/${encodeURIComponent(key)}`, {
+          method: 'DELETE',
+          credentials: 'include',
+        });
+      } catch (err) {
+        log.warn(`Failed to delete KV [${key}] on server:`, err);
+      }
+    }
+  }
+
+  async keys(prefix = '', scope: KVScope = DEFAULT_KV_SCOPE): Promise<string[]> {
+    if (scope === 'device') {
+      return this.local.keys(prefix, 'device');
+    }
+
+    if (typeof window !== 'undefined') {
+      try {
+        const query = prefix ? `?prefix=${encodeURIComponent(prefix)}` : '';
+        const res = await fetch(`/api/kv/keys${query}`, {
+          method: 'GET',
+          credentials: 'include',
+        });
+        if (res.ok) {
+          const keys = await res.json();
+          if (Array.isArray(keys)) return keys;
+        }
+      } catch {
+        // Fallback to local
+      }
+    }
+
+    return this.local.keys(prefix, 'account');
+  }
+}
