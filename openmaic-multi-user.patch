++if [ "$HTTP_CODE" = "200" ]; then
++    echo -e "${GREEN}✓ /workspace 页面状态正常 (HTTP 200)${NC}"
++else
++    echo -e "${RED}✗ /workspace 页面返回状态码: ${HTTP_CODE}${NC}"
++fi
++
++echo -e "${BLUE}======================================================${NC}"
++echo -e "${GREEN}🎉 OpenMAIC 方案 B (Pro 工作台 + 编辑模式) 配置成功！${NC}"
