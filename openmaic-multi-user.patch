+      const data = await res.json();
+      if (data && data.stage) {
+        return {
+          stage: data.stage as Stage,
+          scenes: (data.scenes || []) as Scene[],
+          outline: data.outline as AppDocumentOutline | undefined,
+        };
+      }
+    }
