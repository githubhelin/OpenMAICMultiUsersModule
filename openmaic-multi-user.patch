+/**
+ * Resolve LLM model for a server-managed provider.
+ * When server configures an allowed model list (e.g. OPENAI_MODELS), ensure the
+ * model is in that allowed list; otherwise fall back to DEFAULT_MODEL or serverModels[0].
+ */
+export function resolveLLMModel(providerId: string, clientModel?: string): string | undefined {
+  const serverModels = getConfig().providers[providerId]?.models;
+  if (serverModels?.length) {
+    if (clientModel && serverModels.includes(clientModel)) return clientModel;
+    if (clientModel) {
+      const canonical = getCanonicalModelId(providerId, clientModel);
+      if (serverModels.includes(canonical)) return canonical;
+    }
+    const defaultModel = process.env.DEFAULT_MODEL;
+    if (defaultModel) {
+      const colonIndex = defaultModel.indexOf(':');
+      const defProvider = colonIndex > 0 ? defaultModel.slice(0, colonIndex) : '';
+      const defModel = colonIndex > 0 ? defaultModel.slice(colonIndex + 1) : defaultModel;
+      if (defProvider === providerId && serverModels.includes(defModel)) {
+        return defModel;
+      }
+    }
+    return serverModels[0];
+  }
+  return clientModel;
+}
