+++        task.stepMessage = '任务已取消 (用户中断)';
+++        if (task.tempFilePath) {
+++          safeUnlink(task.tempFilePath);
+++        }
+++      }
+++    }
+++    j.cancelledTasks = j.tasks.filter((t) => t.status === 'cancelled').length;
