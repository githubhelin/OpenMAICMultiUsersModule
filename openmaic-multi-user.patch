+async function fetchRemoteStageDocument(stageId: string): Promise<AppDocument | null> {
+  try {
+    const res = await fetch(`/api/stages/${encodeURIComponent(stageId)}`, {
+      credentials: 'include',
+    });
+    if (res.ok) {
+      const data = await res.json();
+      if (data && data.stage) {
+        return {
+          stage: data.stage as Stage,
+          scenes: (data.scenes || []) as Scene[],
+          outline: data.outline as AppDocumentOutline | undefined,
+        };
+      }
+    }
+  } catch {
+    // network or server error
+  }
+  return null;
